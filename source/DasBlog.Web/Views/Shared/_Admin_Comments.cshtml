@using DasBlog.Web.Models.AdminViewModels

@inject IDasBlogSettings dasBlogSettings
@model DasBlogSettingsViewModel

<h3 class="dbc-settings-subsection-title">Availability</h3>
<div class="row g-3 mb-4">
    <div class="col-md-4 form-check form-switch ps-5">
        @Html.CheckBoxFor(m => @Model.SiteConfig.EnableBlogFeatures, new { @class = "form-check-input me-1" })
        @Html.LabelFor(m => @Model.SiteConfig.EnableBlogFeatures, null, new { @class = "form-check-label" })
    </div>
    <div class="col-md-4 form-check form-switch ps-5">
        @Html.CheckBoxFor(m => @Model.SiteConfig.EnableComments, new { @class = "form-check-input me-1" })
        @Html.LabelFor(m => @Model.SiteConfig.EnableComments, null, new { @class = "form-check-label" })
    </div>
    <div class="col-md-4 form-check form-switch ps-5">
        @Html.CheckBoxFor(m => @Model.SiteConfig.ShowCommentsWhenViewingEntry, new { @class = "form-check-input me-1" })
        @Html.LabelFor(m => @Model.SiteConfig.ShowCommentsWhenViewingEntry, null, new { @class = "form-check-label" })
    </div>
</div>

<div class="col-md-4">
    <div class="form-check">
        @Html.CheckBoxFor(m => @Model.SiteConfig.EnableCommentDays, new { @class = "form-check-input" })
        @Html.LabelFor(m => @Model.SiteConfig.EnableCommentDays, null, new { @class = "form-check-label" })
    </div>
</div>

<div class="col-md-4 mb-3">
    <div class="form-floating">
        @Html.TextBoxFor(m => @Model.SiteConfig.DaysCommentsAllowed, null, new { @class = "form-control", id = "daysCommentsAllowed" })
        @Html.LabelFor(m => @Model.SiteConfig.DaysCommentsAllowed, null, new { @class = "form-label", @for = "daysCommentsAllowed" })
    </div>
    @Html.ValidationMessageFor(m => m.SiteConfig.DaysCommentsAllowed, null, new { @class = "text-danger" })
</div>

<h3 class="dbc-settings-subsection-title mt-4">Comment challenge</h3>
<div class="row gy-2 gx-3 align-items-md-start mb-3">
    <div class="col-sm-5">
        <div class="form-floating">
            @Html.TextBoxFor(m => @Model.SiteConfig.CheesySpamQ, null, new { @class = "form-control", id = "cheesySpamQ" })
            @Html.LabelFor(m => @Model.SiteConfig.CheesySpamQ, null, new { @class = "form-label", @for = "cheesySpamQ" })
        </div>
        @Html.ValidationMessageFor(m => m.SiteConfig.CheesySpamQ, null, new { @class = "text-danger" })
    </div>
    <div class="col-sm-5">
        <div class="form-floating">
            @Html.TextBoxFor(m => @Model.SiteConfig.CheesySpamA, null, new { @class = "form-control", id = "cheesySpamA" })
            @Html.LabelFor(m => @Model.SiteConfig.CheesySpamA, null, new { @class = "form-label", @for = "cheesySpamA" })
        </div>
        @Html.ValidationMessageFor(m => m.SiteConfig.CheesySpamA, null, new { @class = "text-danger" })
    </div>
</div>

<h3 class="dbc-settings-subsection-title mt-4">Moderation</h3>
<div class="col-md-6 mb-3">
    <div class="form-check">
        @Html.CheckBoxFor(m => @Model.SiteConfig.AllowMarkdownInComments, new { @class = "form-check-input" })
        @Html.LabelFor(m => @Model.SiteConfig.AllowMarkdownInComments, null, new { @class = "form-check-label" })
    </div>
    <div class="form-check">
        @Html.CheckBoxFor(m => @Model.SiteConfig.CommentsRequireApproval, new { @class = "form-check-input" })
        @Html.LabelFor(m => @Model.SiteConfig.CommentsRequireApproval, null, new { @class = "form-check-label" })
    </div>
</div>

<h3 class="dbc-settings-subsection-title mt-4">Spam protection</h3>
<div class="row gy-2 gx-3 mb-4">
    <div class="col-12">
        <div class="form-check">
            @Html.CheckBoxFor(m => @Model.SiteConfig.EnableSpamModeration, new { @class = "form-check-input", id = "enableSpamModeration" })
            @Html.LabelFor(m => @Model.SiteConfig.EnableSpamModeration, null, new { @class = "form-check-label" })
        </div>
    </div>
    <div class="col-12">
        <div class="form-floating">
            @Html.TextBoxFor(m => @Model.SiteConfig.AkismetAPIKey, null, new { @class = "form-control", id = "akismetAPIKey", autocomplete = "off" })
            @Html.LabelFor(m => @Model.SiteConfig.AkismetAPIKey, null, new { @class = "form-label", @for = "akismetAPIKey" })
        </div>
        @Html.ValidationMessageFor(m => m.SiteConfig.AkismetAPIKey, null, new { @class = "text-danger" })
    </div>
</div>

<h3 class="dbc-settings-subsection-title">Allowed markup</h3>
<div class="row mb-3">
    @Html.LabelFor(m => @Model.SiteConfig.ValidCommentTags, null, new { @class = "col-form-label" })    
    <div class="dasblog-col-body col-sm-10 d-flex flex-wrap gap-3">
        @for (var i = 0; i < @Model.SiteConfig.ValidCommentTags[0].Tag.Count; i++)
        {
            <div class="form-check mb-0">
                <input type="checkbox" class="form-check-input" asp-for="@Model.SiteConfig.ValidCommentTags[0].Tag[i].Allowed" />
                <label class="form-check-label" asp-for="@Model.SiteConfig.ValidCommentTags[0].Tag[i].Allowed">@Model.SiteConfig.ValidCommentTags[0].Tag[i].Name</label>
                <input type="hidden" asp-for="@Model.SiteConfig.ValidCommentTags[0].Tag[i].Attributes" />
                <input type="hidden" asp-for="@Model.SiteConfig.ValidCommentTags[0].Tag[i].Name" />
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const enableCommentsCheckbox = document.querySelector('[id$="EnableComments"]');
        const enableCommentDaysCheckbox = document.querySelector('[id$="EnableCommentDays"]');
        const daysCommentsAllowedTextbox = document.getElementById('daysCommentsAllowed');
        const enableSpamModerationCheckbox = document.getElementById('enableSpamModeration');
        const akismetApiKeyTextbox = document.getElementById('akismetAPIKey');
        // Keep the two top-level feature switches enabled so they post independently.
        const enableBlogFeaturesCheckbox = document.querySelector('[id$="EnableBlogFeatures"]');
        const commentsSection = document.getElementById('commentsSettings');
        const allFormFields = Array.from(commentsSection.querySelectorAll('input, select, textarea'))
            .filter(el => el !== enableCommentsCheckbox && el !== enableBlogFeaturesCheckbox);

        function toggleBlogFeatures() {
            const blogFeaturesEnabled = enableBlogFeaturesCheckbox.checked;
            enableCommentsCheckbox.checked = blogFeaturesEnabled;
            enableCommentsCheckbox.disabled = !blogFeaturesEnabled;
            toggleAllFields();
        }

        function toggleDaysCommentsAllowed() {
            const isEnabled = enableCommentDaysCheckbox.checked && enableCommentsCheckbox.checked;
            daysCommentsAllowedTextbox.disabled = !isEnabled;
        }

        function toggleAkismetApiKey() {
            if (!enableSpamModerationCheckbox || !akismetApiKeyTextbox) return;
            const isEnabled = enableSpamModerationCheckbox.checked && enableCommentsCheckbox.checked;
            akismetApiKeyTextbox.disabled = !isEnabled;
        }

        function toggleAllFields() {
            const enabled = enableCommentsCheckbox.checked;
            allFormFields.forEach(field => {
                field.disabled = !enabled;
            });
            // If enabled, apply field-specific logic
            if (enabled) {
                toggleDaysCommentsAllowed();
                toggleAkismetApiKey();
            }
        }

        // Initialize on page load
        toggleBlogFeatures();
        // Listen for changes
        enableBlogFeaturesCheckbox.addEventListener('change', toggleBlogFeatures);
        enableCommentsCheckbox.addEventListener('change', toggleAllFields);
        enableCommentDaysCheckbox.addEventListener('change', function () {
            if (enableCommentsCheckbox.checked) toggleDaysCommentsAllowed();
        });
        if (enableSpamModerationCheckbox) {
            enableSpamModerationCheckbox.addEventListener('change', function () {
                if (enableCommentsCheckbox.checked) toggleAkismetApiKey();
            });
        }

        // Re-enable disabled fields before form submission so their values are posted.
        // Disabled inputs are excluded from form submission, which causes server-side
        // validation to fail (e.g. DaysCommentsAllowed defaults to 0 and fails Range(1,500)).
        const settingsForm = commentsSection.closest('form');
        if (settingsForm) {
            settingsForm.addEventListener('submit', function () {
                allFormFields.forEach(field => { field.disabled = false; });
            });
        }
    });
</script>
