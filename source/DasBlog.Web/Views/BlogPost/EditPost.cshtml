@model DasBlog.Web.Models.BlogViewModels.PostViewModel
@using DasBlog.Core.Common

@{
    ViewBag.Title = "Edit Post";
    Layout = "../../Themes/dasblog/_Layout.cshtml";

    // Configure modal parameters
    ViewData["ModalId"] = "confirmSaveModal";
    ViewData["ModalTitle"] = "Confirm Save";
    ViewData["ModalMessage"] = "Are you sure you want to save changes to this blog post?";
    ViewData["ModalConfirmText"] = "Save Changes";
    ViewData["HiddenButtonId"] = "hiddenSaveButton";
}

<h1>@ViewData["Title"]</h1>
<hr />

<!-- Success Alert using reusable partial -->
<partial name="_SuccessAlertPartial" view-data="ViewData" />

<form action="@Url.Content("~/admin/post/edit")" method="post" enctype="multipart/form-data" id="EditPostForm">
    @Html.AntiForgeryToken()

    <partial name="BlogPostFields" model="Model" />

    <div class="dbc-admin-actions d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4">
        <a class="btn btn-outline-secondary" href="@Model.PermaLink">
            <i class="fa-solid fa-arrow-up-right-from-square me-2" aria-hidden="true"></i>View post
        </a>
        <div class="dbc-admin-actions-buttons d-flex gap-2 ms-auto">
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmSaveModal">
                <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Save changes
            </button>
        </div>
    </div>

    <!-- Hidden submit button for actual form submission -->
    <input type="submit" name="submit" value="Save" id="hiddenSaveButton" style="display:none;" />

    @Html.HiddenFor(m => m.EntryId)
    @Html.HiddenFor(m => m.Author)
    @Html.HiddenFor(m => m.CreatedDateTime)

</form>

<!-- Confirmation Modal using reusable partial -->
<partial name="_ConfirmationModalPartial" view-data="ViewData" />

@section Scripts {
    <rich-edit-scripts control-id="mytextarea" />

    @{await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script src="~/js/dasblog-ui.js"></script>
}
