@model DasBlog.Web.Models.BlogViewModels.PostViewModel

@{
    ViewBag.Title = "New Post";
    Layout = "../../Themes/dasblog/_Layout.cshtml";

    // Configure modal parameters
    ViewData["ModalId"] = "confirmCreateModal";
    ViewData["ModalTitle"] = "Confirm Create Post";
    ViewData["ModalMessage"] = "Are you sure you want to create this blog post?";
    ViewData["ModalConfirmText"] = "Create Post";
    ViewData["HiddenButtonId"] = "hiddenCreateButton";
}

<h1>@ViewData["Title"]</h1>
<hr />

<!-- Success Alert using reusable partial -->
<partial name="_SuccessAlertPartial" view-data="ViewData" />

<form action="@Url.Content("~/admin/post/create")" method="post" enctype="multipart/form-data" id="CreatePostForm">
    @Html.AntiForgeryToken()

    <partial name="BlogPostFields" model="Model" />

    <div class="dbc-admin-actions d-flex flex-wrap align-items-center justify-content-end gap-3 mt-4">
        <div class="dbc-admin-actions-buttons d-flex gap-2 ms-auto">
            <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Cancel</a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmCreateModal">
                <i class="fa-solid fa-plus me-2" aria-hidden="true"></i>Create post
            </button>
        </div>
    </div>

    <!-- Hidden submit button for actual form submission -->
    <input type="submit" name="submit" value="Create Post" id="hiddenCreateButton" style="display:none;" />

    @Html.HiddenFor(m => m.EntryId)
    @Html.HiddenFor(m => m.Author)
    @Html.HiddenFor(m => m.CreatedDateTime)

</form>

<!-- Confirmation Modal using reusable partial -->
<partial name="_ConfirmationModalPartial" view-data="ViewData" />

@section scripts {
    <rich-edit-scripts control-id="mytextarea" />
    <script src="~/js/dasblog-ui.js"></script>
}