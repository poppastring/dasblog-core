                    <span class="dbc-settings-section-label d-block">
                        <span class="dbc-settings-section-title d-block fw-semibold">General</span>
                        <span class="dbc-settings-section-description d-block small text-body-secondary mt-1">Site identity, contact details, and active theme</span>
                    </span>
                </button>
            </h2>
            <div id="collapseGeneral" class="accordion-collapse collapse show" data-bs-parent="#settingsAccordion">
