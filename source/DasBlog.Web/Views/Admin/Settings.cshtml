                    </span>
                </button>
            </h2>
            <div id="collapseMetaData" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                <div class="accordion-body">
                    <partial name="_Admin_MetaData" />
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseSocial" aria-expanded="false" aria-controls="collapseSocial">
                    <i class="fa-solid fa-share-nodes me-3" aria-hidden="true"></i>
                    <span class="dbc-settings-section-label d-block">
                        <span class="dbc-settings-section-title d-block fw-semibold">Social</span>
                        <span class="dbc-settings-section-description d-block small text-body-secondary mt-1">Social profiles and preview images</span>
                    </span>
