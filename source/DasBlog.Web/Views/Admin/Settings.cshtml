                        <span class="dbc-settings-section-description d-block small text-body-secondary mt-1">Display and formatting preferences</span>
                    </span>
                </button>
            </h2>
            <div id="collapseAppearance" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                <div class="accordion-body">
                    <partial name="_Admin_Appearance" />
                </div>
            </div>
        </div>

        <h2 class="dbc-settings-group-title">Publishing &amp; discovery</h2>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMetaData" aria-expanded="false" aria-controls="collapseMetaData">
                    <i class="fa-solid fa-tags me-3" aria-hidden="true"></i>
                    <span class="dbc-settings-section-label d-block">
                        <span class="dbc-settings-section-title d-block fw-semibold">Metadata</span>
