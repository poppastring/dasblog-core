                    <partial name="_Admin_General" />
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseFrontPage" aria-expanded="false" aria-controls="collapseFrontPage">
                    <i class="fa-solid fa-house me-3" aria-hidden="true"></i>
                    <span class="dbc-settings-section-label d-block">
                        <span class="dbc-settings-section-title d-block fw-semibold">Front Page</span>
                        <span class="dbc-settings-section-description d-block small text-body-secondary mt-1">Homepage content and presentation</span>
                    </span>
                </button>
            </h2>
            <div id="collapseFrontPage" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
