    <div class="dbc-admin-actions d-flex flex-wrap align-items-center justify-content-between gap-3 mt-4">
        <span class="dbc-settings-dirty-status text-body-secondary" role="status" aria-live="polite">No unsaved changes</span>
        <div class="dbc-admin-actions-buttons d-flex gap-2 ms-auto">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#confirmSaveModal" id="settingsSaveButton" disabled>
                <i class="fa-solid fa-floppy-disk me-2" aria-hidden="true"></i>Save changes
            </button>
        </div>
    </div>

    <!-- Hidden submit button for actual form submission -->
    <input type="submit" name="submitAction" value="Save" id="hiddenSaveButton" style="display:none;" />

    @section Scripts {

        <script src="~/lib/jquery-validate/1.19.5/jquery.validate.min.js"></script>
        <script src="~/lib/jquery-validation-unobtrusive/3.2.11/jquery.validate.unobtrusive.min.js"></script>
        <script src="~/js/dasblog-ui.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const settingsForm = document.getElementById('UpdateSettingsForm');
                const saveButton = document.getElementById('settingsSaveButton');
                const dirtyStatus = document.querySelector('.dbc-settings-dirty-status');
                const accordionItems = document.querySelectorAll('#settingsAccordion .accordion-collapse');
                const accordionStorageKey = 'settingsAccordionState';
                if (sessionStorage.getItem(accordionStorageKey) !== null) {
                    accordionItems.forEach(function(item) {
                        item.classList.remove('show');
                        const trigger = document.querySelector(`[data-bs-target="#${item.id}"]`);
                        trigger.classList.add('collapsed');
                        trigger.setAttribute('aria-expanded', 'false');
                    });
                }
                DasBlog.UI.initAccordionTracking(accordionStorageKey, accordionItems);

                function setDirtyState(isDirty) {
                    saveButton.disabled = !isDirty;
                    dirtyStatus.textContent = isDirty ? 'Unsaved changes' : 'No unsaved changes';
                    dirtyStatus.classList.remove('text-danger');
                    dirtyStatus.classList.toggle('text-primary', isDirty);
                    dirtyStatus.classList.toggle('text-body-secondary', !isDirty);
                }

                settingsForm.addEventListener('input', function() {
                    setDirtyState(true);
                });
                settingsForm.addEventListener('change', function() {
                    setDirtyState(true);
                });

                const invalidFields = settingsForm.querySelectorAll('.input-validation-error');
                const errorPanels = new Set();
                invalidFields.forEach(function(field) {
                    const panel = field.closest('.accordion-collapse');
                    if (panel) {
                        errorPanels.add(panel);
                        panel.closest('.accordion-item').classList.add('dbc-settings-section-error');
                    }
                });

                if (errorPanels.size > 0) {
                    const firstErrorPanel = errorPanels.values().next().value;
                    bootstrap.Collapse.getOrCreateInstance(firstErrorPanel, { toggle: false }).show();
                    setDirtyState(true);
                    dirtyStatus.textContent = 'Review validation errors';
                    dirtyStatus.classList.remove('text-primary');
                    dirtyStatus.classList.add('text-danger');
                }

                const confirmSaveButton = document.getElementById('confirmSaveModalButton');
                if (confirmSaveButton) {
                    confirmSaveButton.addEventListener('click', function() {
                        DasBlog.UI.saveAccordionState(accordionStorageKey, accordionItems);
                    });
                }

                settingsForm.addEventListener('submit', function() {
                    DasBlog.UI.saveAccordionState(accordionStorageKey, accordionItems);
                });
            });
        </script>

    }


    @Html.HiddenFor(@m => m.SiteConfig.EnableTitlePermaLinkSpaces)
    @Html.HiddenFor(@m => m.SiteConfig.CategoryAllEntries)

    @Html.HiddenFor(@m => m.SiteConfig.EntryTitleAsLink)
    @Html.HiddenFor(@m => m.SiteConfig.ObfuscateEmail)

    @Html.HiddenFor(@m => m.SiteConfig.CommentsAllowHtml)

    @Html.HiddenFor(@m => m.SiteConfig.RssLanguage)
    @Html.HiddenFor(@m => m.SiteConfig.EnableSearchHighlight)

    @Html.HiddenFor(@m => m.SiteConfig.LogBlockedReferrals)

    @Html.HiddenFor(@m => m.SiteConfig.CommentsAllowGravatar)
    @Html.HiddenFor(@m => m.SiteConfig.CommentsGravatarNoImgPath)
    @Html.HiddenFor(@m => m.SiteConfig.CommentsGravatarSize)

    @Html.HiddenFor(@m => m.SiteConfig.CommentsGravatarBorder)
