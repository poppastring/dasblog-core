            </h2>
            <div id="collapseSecurity" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
                <div class="accordion-body">
                    <partial name="_Admin_Security" />
                </div>
            </div>
        </div>
        <div class="accordion-item">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseInternal" aria-expanded="false" aria-controls="collapseInternal">
                    <i class="fa-solid fa-server me-3" aria-hidden="true"></i>
                    <span class="dbc-settings-section-label d-block">
                        <span class="dbc-settings-section-title d-block fw-semibold">Storage &amp; Runtime</span>
                        <span class="dbc-settings-section-description d-block small text-body-secondary mt-1">Directories, time zone, and content delivery</span>
                    </span>
                </button>
            </h2>
            <div id="collapseInternal" class="accordion-collapse collapse" data-bs-parent="#settingsAccordion">
